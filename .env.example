# DeepSeek API key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# 高德地图 Web JS API (https://console.amap.com/dev/key/app)
AMAP_API_KEY=
AMAP_SECURITY_CODE=

# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=

MAPBOX_ACCESS_TOKEN=

# OpenRouteService (HeiGIT) — https://openrouteservice.org/dev/#/signup
# Free "Basic" key: Directions V2 2000 req/month, 40/min. Used by
# calculate_distance as the primary road-network routing provider (Mapbox
# Directions is the fallback if this is unset or a call fails; a straight-
# line estimate is the last resort — see server/tools/mapbox.ts).
ORS_API_KEY=

# Geoapify (https://myprojects.geoapify.com/) — free tier: 3,000 credits/day,
# no credit card. Primary provider for search_places/get_poi_details/
# calculate_distance internationally (see server/tools/geoapify.ts's module
# docstring for why it's primary rather than a fallback); OSM Overpass and
# ORS/Mapbox remain as free backup layers if these are unset or a call fails.
GEOAPIFY_PLACES_API_KEY=
GEOAPIFY_ROUTING_API_KEY=


# Set to "true" to disable the agent's 5-layer error-recovery pipeline (for
# measuring what it actually catches — see CLAUDE.md). Leave unset/false for
# normal use; this is a testing-only knob.
DISABLE_ERROR_RECOVERY=
